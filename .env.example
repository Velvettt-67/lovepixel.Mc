# LovePixels Backend & Discord Integration Configuration
# Place this file as `.env` in the project root:
# C:\Users\obito\OneDrive\Documents\Lovepixel\.env

PORT=3001
NODE_ENV=development

# ------------------------------------------------------------------------------
# DISCORD APPLICATION OAUTH2 CONFIGURATION
# Obtain from your existing Discord bot application:
# https://discord.com/developers/applications
# ------------------------------------------------------------------------------

# 1. Your Discord Application Client ID (under General Information or OAuth2)
DISCORD_CLIENT_ID=your_client_id_here

# 2. Your Discord Application Client Secret (under OAuth2 tab -> Client Secret)
# WARNING: Do NOT use the Bot Token here. Client Secret is under the OAuth2 tab.
DISCORD_CLIENT_SECRET=your_client_secret_here

# 3. Exact Redirect URI registered under Discord Developer Portal -> OAuth2 -> Redirects:
# Local development:
DISCORD_REDIRECT_URI=http://localhost:5173/api/auth/discord/callback
# Production (replace with your live domain):
# DISCORD_REDIRECT_URI=https://your-production-domain.com/api/auth/discord/callback

# ------------------------------------------------------------------------------
# DISCORD BOT CREDENTIALS & GUILD SETTINGS
# ------------------------------------------------------------------------------

# Bot Token (under Bot tab -> Reset Token / Token)
# Required for reading real Discord messages, attachments, and bridge sending
DISCORD_BOT_TOKEN=your_bot_token_here

# Official LovePixels Discord Guild ID
DISCORD_GUILD_ID=1498650220215664781

# Admin Discord User IDs (Comma-separated IDs allowed to access /admin/inbox)
# Example: ADMIN_DISCORD_IDS=123456789012345678,987654321098765432
ADMIN_DISCORD_IDS=

# Session Secret for signing authentication cookies
SESSION_SECRET=lovepixel-secret-celestial-sanctuary-key-2026
